# URL base do iEducar visto de dentro da rede do Docker Compose (servico nginx)
IEDUCAR_BASE_URL=http://nginx
# Token Sanctum gerado com: docker compose exec fpm php artisan admin:token "moodle-sync"
IEDUCAR_API_TOKEN=

# URL base do Moodle visto de dentro da rede do Docker Compose (servico moodle)
MOODLE_BASE_URL=http://moodle:8080
# Token do Web Service REST, gerado em Administracao do site > Servidor > Web services > Gerenciar tokens
MOODLE_WS_TOKEN=
# Categoria do Moodle onde os cursos sincronizados serao criados (id numerico)
MOODLE_CATEGORY_ID=1

# Ano letivo considerado pela sincronizacao (turmas/matriculas ativas deste ano)
ACTIVE_YEAR=2026

# Intervalo entre ciclos automaticos de sincronizacao
POLL_INTERVAL_SECONDS=30

PORT=3000
DB_PATH=/app/data/integration.db
LOG_LEVEL=info
