# Portas expostas no host
DOCKER_MOODLE_PORT=8080
DOCKER_MOODLE_SSL_PORT=8443
DOCKER_POSTGRESQL_PORT=5432

# Banco de dados (PostgreSQL)
POSTGRESQL_POSTGRES_PASSWORD=moodle_root
MOODLE_DATABASE_NAME=bitnami_moodle
MOODLE_DATABASE_USER=bn_moodle
MOODLE_DATABASE_PASSWORD=moodle_password

# Conta de administrador criada no primeiro boot
MOODLE_USERNAME=admin
MOODLE_PASSWORD=moodle_admin_pw
MOODLE_EMAIL=admin@example.com
MOODLE_SITE_NAME=Moodle Legacy
MOODLE_HOST=localhost:8080

# Proxy reverso / SSL (ajuste caso rode atrás de nginx/traefik com HTTPS)
MOODLE_REVERSEPROXY=no
MOODLE_SSLPROXY=no

# SMTP (opcional — deixe em branco para desativar o envio de e-mail)
MOODLE_SMTP_HOST=
MOODLE_SMTP_PORT_NUMBER=587
MOODLE_SMTP_USER=
MOODLE_SMTP_PASSWORD=
MOODLE_SMTP_PROTOCOL=tls
